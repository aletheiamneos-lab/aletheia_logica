<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ report.test_name }}</title>
    <style>
      @page {
        size: A4;
        margin: 0;
      }

      * {
        box-sizing: border-box;
      }

      :root {
        --ink: #103f3d;
        --teal: #0b665f;
        --teal-dark: #084d49;
        --text: #10252a;
        --muted: #68716f;
        --line: #dce2df;
        --danger: #c93d35;
        --success: #178451;
      }

      html,
      body {
        margin: 0;
        padding: 0;
      }

      body {
        background: #eef1f0;
        color: var(--text);
        font-family: Georgia, "Times New Roman", serif;
      }

      .page {
        position: relative;
        width: 210mm;
        min-height: 297mm;
        margin: 0 auto 16px;
        padding: 11mm 10mm 19mm;
        overflow: hidden;
        background: #fff;
        break-after: page;
        page-break-after: always;
      }

      .page:last-child {
        break-after: auto;
        page-break-after: auto;
      }

      .topbar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
      }

      .brand-title {
        color: var(--teal-dark);
        font-size: 30px;
        font-weight: 700;
        line-height: 0.96;
      }

      .brand-subtitle {
        margin-top: 3px;
        color: var(--ink);
        font-size: 11px;
      }

      .top-right {
        margin-top: 3px;
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 10px;
        font-weight: 700;
        letter-spacing: 0.16em;
      }

      .top-rule {
        margin: 4mm 0 6mm;
        border-top: 1px solid var(--teal-dark);
      }

      .title-block {
        margin-bottom: 6mm;
        text-align: center;
      }

      .report-title {
        margin: 0;
        color: var(--ink);
        font-size: 22px;
        letter-spacing: 0.03em;
      }

      .test-name {
        margin-top: 2mm;
        color: var(--text);
        font-size: 14px;
      }

      .title-ornament {
        position: relative;
        width: 27mm;
        margin: 4mm auto 0;
        border-top: 1px solid var(--teal);
      }

      .title-ornament::after {
        position: absolute;
        top: -4px;
        left: calc(50% - 3px);
        width: 6px;
        height: 6px;
        background: var(--teal);
        content: "";
        transform: rotate(45deg);
      }

      .meta-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 78mm;
        gap: 10mm;
        align-items: start;
      }

      .meta {
        display: grid;
        gap: 2.2mm;
        font-size: 11px;
      }

      .meta-row {
        display: grid;
        grid-template-columns: 35mm minmax(0, 1fr);
      }

      .meta-label {
        font-weight: 700;
      }

      .meta-value {
        color: #163943;
      }

      .intro {
        color: #283638;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 9.5px;
        line-height: 1.48;
        text-align: justify;
        text-justify: auto;
        hyphens: auto;
      }

      .kpis {
        display: grid;
        grid-template-columns: 1.05fr 1fr 1.3fr 1.1fr;
        align-items: center;
        margin-top: 7mm;
      }

      .kpi {
        display: flex;
        min-height: 32mm;
        align-items: center;
        justify-content: center;
        padding: 2mm 5mm;
        border-right: 1px solid var(--line);
        text-align: center;
      }

      .kpi:last-child {
        border-right: 0;
      }

      .kpi-value {
        color: var(--teal-dark);
        font-size: 23px;
        font-weight: 700;
      }

      .kpi-label {
        margin-top: 2.5mm;
        color: var(--text);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8px;
        font-weight: 700;
        line-height: 1.35;
        text-transform: uppercase;
      }

      .score-ring {
        --score-angle: calc(var(--score) * 3.6deg);
        position: relative;
        display: grid;
        width: 28mm;
        height: 28mm;
        margin: 0 auto;
        place-items: center;
        border-radius: 50%;
        background: conic-gradient(var(--teal) var(--score-angle), #e5e7e5 0);
      }

      .score-ring::after {
        position: absolute;
        width: 22mm;
        height: 22mm;
        border-radius: 50%;
        background: #fff;
        content: "";
      }

      .score-ring strong {
        position: relative;
        z-index: 1;
        color: var(--text);
        font-size: 22px;
      }

      .clock {
        position: relative;
        width: 9mm;
        height: 9mm;
        margin: 0 auto 2mm;
        border: 1.5px solid var(--text);
        border-radius: 50%;
      }

      .clock::before,
      .clock::after {
        position: absolute;
        left: 50%;
        top: 50%;
        width: 1px;
        background: var(--text);
        content: "";
        transform-origin: bottom;
      }

      .clock::before {
        height: 2.5mm;
        transform: translate(-50%, -100%);
      }

      .clock::after {
        height: 2mm;
        transform: translate(-50%, -100%) rotate(120deg);
      }

      .section-heading,
      .review-title {
        margin: 5.5mm 0 2.5mm;
        color: var(--ink);
        font-size: 15px;
      }

      .performance-grid {
        display: grid;
        grid-template-columns: 82mm minmax(0, 1fr);
        gap: 9mm;
        align-items: center;
      }

      .radar-wrap {
        display: grid;
        min-height: 55mm;
        place-items: center;
      }

      .radar-wrap svg {
        display: block;
        width: 100%;
        max-height: 57mm;
      }

      .zone-table {
        width: 100%;
        border-collapse: collapse;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 9.5px;
      }

      .zone-table th {
        padding: 2mm 1.2mm;
        color: var(--teal-dark);
        font-size: 7.5px;
        letter-spacing: 0.08em;
        text-align: left;
        text-transform: uppercase;
      }

      .zone-table td {
        padding: 2.4mm 1.2mm;
        border-bottom: 1px dotted #cfd6d3;
      }

      .zone-table tr:last-child td {
        border-bottom: 0;
      }

      .dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 2.5mm;
        border-radius: 50%;
      }

      .review-title {
        margin-top: 4.5mm;
      }

      .review-card,
      .answer-detail {
        overflow: hidden;
        border: 1px solid #dfe5e2;
        border-radius: 5px;
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .review-head {
        padding: 2.4mm 4mm;
        background: var(--teal-dark);
        color: #fff;
        font-size: 12px;
        font-weight: 700;
      }

      .qrow {
        display: grid;
        grid-template-columns: 8mm minmax(0, 1fr) 24mm 5mm;
        gap: 2.5mm;
        min-height: 9.5mm;
        align-items: center;
        padding: 1.4mm 3mm;
        border-bottom: 1px solid #e7ebe9;
        font-family: Arial, Helvetica, sans-serif;
      }

      .qrow:last-child {
        border-bottom: 0;
      }

      .qnum {
        display: grid;
        width: 6.5mm;
        height: 6.5mm;
        place-items: center;
        border-radius: 50%;
        background: var(--teal-dark);
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8px;
        font-weight: 700;
      }

      .qtext {
        display: -webkit-box;
        overflow: hidden;
        font-size: 8.5px;
        line-height: 1.3;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
      }

      .status {
        justify-self: end;
        padding: 1.2mm 2.2mm;
        border: 1px solid;
        border-radius: 999px;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 7px;
        font-weight: 700;
      }

      .status.correct {
        border-color: #b7dfca;
        background: #f5fbf7;
        color: var(--success);
      }

      .status.wrong {
        border-color: #f1b7b1;
        background: #fff8f7;
        color: var(--danger);
      }

      .status.incomplete {
        border-color: #d6d9d8;
        background: #fafafa;
        color: #777;
      }

      .chev {
        color: var(--ink);
        font-size: 14px;
      }

      .detail-page .section-heading {
        margin-top: 2mm;
      }

      .detail-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        margin: 2mm 0 2.5mm;
      }

      .detail-heading .section-heading {
        margin: 0;
      }

      .question-range {
        color: var(--muted);
        font-family: Arial, Helvetica, sans-serif;
        font-size: 7.5px;
      }

      .answer-detail {
        margin-bottom: 3.2mm;
      }

      .answer-head {
        display: grid;
        grid-template-columns: 9mm minmax(0, 1fr) auto;
        gap: 2.5mm;
        align-items: center;
        padding: 2.3mm 3mm;
      }

      .answer-body {
        padding: 2.6mm 4mm 3mm 15mm;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8.5px;
        line-height: 1.36;
      }

      .option {
        margin: 0.8mm 0;
      }

      .option.correct-answer {
        color: var(--success);
        font-weight: 700;
      }

      .option.student-wrong {
        color: var(--danger);
      }

      .feedback-line {
        margin-top: 2mm;
        padding-top: 1.8mm;
        border-top: 1px dotted #d5dbd8;
      }

      .footer {
        position: absolute;
        right: 0;
        bottom: 0;
        left: 0;
        display: flex;
        min-height: 14mm;
        align-items: center;
        justify-content: space-between;
        padding: 0 10mm;
        background: var(--teal-dark);
        color: #fff;
        font-family: Arial, Helvetica, sans-serif;
        font-size: 8.5px;
      }

      .footer-left {
        display: flex;
        align-items: center;
        gap: 2.5mm;
      }

      .footer-mark {
        display: grid;
        width: 7mm;
        height: 8mm;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.8);
        font-family: Georgia, "Times New Roman", serif;
        font-size: 8px;
      }

      @media print {
        body {
          background: #fff;
        }

        .page {
          margin: 0;
        }
      }
    </style>
  </head>
  <body>
    <section class="page">
      <div class="topbar">
        <div>
          <div class="brand-title">{{ brand.title }}</div>
          <div class="brand-subtitle">{{ brand.subtitle }}</div>
        </div>
        <div class="top-right">{{ brand.top_right_label }}</div>
      </div>
      <div class="top-rule"></div>

      <div class="title-block">
        <h1 class="report-title">{{ report.title }}</h1>
        <div class="test-name">{{ report.test_name }}</div>
        <div class="title-ornament"></div>
      </div>

      <div class="meta-grid">
        <div class="meta">
          <div class="meta-row"><div class="meta-label">Nume candidat:</div><div class="meta-value">{{ report.candidate_name }}</div></div>
          <div class="meta-row"><div class="meta-label">Data susținerii:</div><div class="meta-value">{{ report.test_date }}</div></div>
          <div class="meta-row"><div class="meta-label">Număr întrebări:</div><div class="meta-value">{{ report.question_count }}</div></div>
        </div>
        <div class="intro">{{ report.intro_text }}</div>
      </div>

      <div class="kpis">
        <div class="kpi">
          <div>
            <div class="score-ring" style="--score: {{ report.score_percent }}"><strong>{{ report.score_percent }}%</strong></div>
            <div class="kpi-label">Scor obținut</div>
          </div>
        </div>
        <div class="kpi">
          <div>
            <div class="kpi-value">{{ report.score_fraction }}</div>
            <div class="kpi-label">Răspunsuri<br />corecte</div>
          </div>
        </div>
        <div class="kpi">
          <div>
            <div class="kpi-value" style="font-size: 19px">{{ report.performance_label }}</div>
            <div class="kpi-label">Performanță</div>
          </div>
        </div>
        <div class="kpi">
          <div>
            <div class="clock"></div>
            <div class="kpi-value" style="font-size: 19px">{{ report.completion_time }}</div>
            <div class="kpi-label">Timp completare</div>
          </div>
        </div>
      </div>

      <h2 class="section-heading">PERFORMANȚĂ PE ZONE</h2>
      <div class="performance-grid">
        <div class="radar-wrap">{{ radar_svg | safe }}</div>
        <table class="zone-table">
          <thead>
            <tr><th>Zonă</th><th>Corecte / 5</th><th>%</th></tr>
          </thead>
          <tbody>
            {% for zone in zones %}
              <tr>
                <td><span class="dot" style="background: {{ zone.accent }}"></span>{{ zone.label }}</td>
                <td>{{ zone.correct }} / {{ zone.total }}</td>
                <td>{{ zone.percent }}%</td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>

      <h2 class="review-title">REVIZUIREA RĂSPUNSURILOR</h2>
      {% set first_section = review_sections[0] %}
      <div class="review-card">
        <div class="review-head">{{ first_section.code }}. {{ first_section.title }}</div>
        {% for question in first_section.questions %}
          <div class="qrow">
            <div class="qnum">{{ question.number }}</div>
            <div class="qtext">{{ question.text }}</div>
            <div class="status {{ question.status }}">
              {% if question.status == "correct" %}CORECT{% elif question.status == "wrong" %}GREȘIT{% else %}NECOMPLETAT{% endif %}
            </div>
            <div class="chev">›</div>
          </div>
        {% endfor %}
      </div>

      <div class="footer">
        <div class="footer-left"><div class="footer-mark">A</div><div>{{ brand.footer_brand }} &nbsp;|&nbsp; {{ brand.footer_tagline }}</div></div>
        <div>Pagina 1 din {{ report.page_count_display }}</div>
      </div>
    </section>

    {% for detail_page in review_pages %}
      <section class="page detail-page">
        <div class="topbar">
          <div>
            <div class="brand-title" style="font-size: 22px">{{ brand.title }}</div>
            <div class="brand-subtitle">{{ brand.subtitle }}</div>
          </div>
          <div class="top-right">{{ brand.top_right_label }}</div>
        </div>
        <div class="top-rule"></div>
        <div class="detail-heading">
          <h2 class="section-heading">{{ detail_page.code }}. {{ detail_page.title }}</h2>
          {% if detail_page.questions %}
            <div class="question-range">
              Întrebările {{ detail_page.questions[0].number }}–{{ detail_page.questions[-1].number }}
            </div>
          {% endif %}
        </div>

        {% for question in detail_page.questions %}
          <article class="answer-detail" id="question-{{ question.number }}">
            <div class="answer-head">
              <div class="qnum">{{ question.number }}</div>
              <div class="qtext">{{ question.text }}</div>
              <div class="status {{ question.status }}">
                {% if question.status == "correct" %}CORECT{% elif question.status == "wrong" %}GREȘIT{% else %}NECOMPLETAT{% endif %}
              </div>
            </div>
            <div class="answer-body">
              {% for letter, text in question.options.items() %}
                <div class="option {% if question.status == 'correct' and letter == question.student_answer %}correct-answer{% elif question.status == 'wrong' and letter == question.correct_answer %}correct-answer{% elif question.status == 'wrong' and letter == question.student_answer %}student-wrong{% endif %}">
                  <strong>{{ letter }}.</strong> {{ text }}
                </div>
              {% endfor %}
              <div class="feedback-line">
                Răspuns elev: <strong>{{ question.student_answer or "—" }}</strong>
                {% if question.status == "wrong" %}
                  &nbsp;&nbsp;|&nbsp;&nbsp; Varianta corectă: <strong>{{ question.correct_answer or "—" }}</strong>
                {% endif %}
              </div>
            </div>
          </article>
        {% endfor %}

        <div class="footer">
          <div class="footer-left"><div class="footer-mark">A</div><div>{{ brand.footer_brand }} &nbsp;|&nbsp; {{ brand.footer_tagline }}</div></div>
          <div>Pagina {{ detail_page.page_number }} din {{ report.page_count_display }}</div>
        </div>
      </section>
    {% endfor %}
  </body>
</html>
